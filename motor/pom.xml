<?xml version="1.0" encoding="UTF-8"?>
<!--
  Motor da Mesa: ponte entre o motor do XMage e o site Mesa do Comandante.
  Compila contra os módulos do XMage (instale-os antes com `mvn install -DskipTests` na raiz do XMage)
  e roda dentro da pasta do servidor do XMage, usando as bibliotecas de lib/.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>mesa</groupId>
  <artifactId>motor-da-mesa</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <xmage.version>1.4.62</xmage.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- "provided": já vêm na pasta lib/ do servidor do XMage -->
    <dependency>
      <groupId>org.mage</groupId>
      <artifactId>mage-common</artifactId>
      <version>${xmage.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mage</groupId>
      <artifactId>mage</artifactId>
      <version>${xmage.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.13.2</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>motor-da-mesa</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>mesa.motor.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
